import difflib
import hashlib

class ModeloIA:
    def __init__(self, nombre, codigo_fuente):
        self.nombre = nombre
        self.codigo = codigo_fuente
        self.hash = self.calcular_hash()

    def calcular_hash(self):
        return hashlib.sha256(self.codigo.encode()).hexdigest()

    def comparar_con(self, otro_modelo):
        diferencias = list(difflib.unified_diff(
            self.codigo.splitlines(),
            otro_modelo.codigo.splitlines(),
            fromfile=self.nombre,
            tofile=otro_modelo.nombre,
            lineterm=''
        ))
        return diferencias

class DesfragmentadorClonesIA:
    def __init__(self, clones):
        self.clones = clones

    def auditar_clones(self):
        print("🔍 Auditando consistencia entre clones...\n")
        base = self.clones[0]
        inconsistencias = 0

        for clone in self.clones[1:]:
            if clone.hash != base.hash:
                print(f"⚠️ Diferencias entre {base.nombre} y {clone.nombre}:")
                diff = base.comparar_con(clone)
                for linea in diff:
                    print("   " + linea)
                inconsistencias += 1
            else:
                print(f"✅ {clone.nombre} es idéntico a {base.nombre}.")

        print(f"\n🧮 Clones auditados: {len(self.clones)}")
        print(f"⚠️ Inconsistencias detectadas: {inconsistencias}")

    def desfragmentar(self):
        print("\n🧹 Iniciando proceso de desfragmentación...\n")
        unicos = {}
        for modelo in self.clones:
            if modelo.hash not in unicos:
                unicos[modelo.hash] = modelo
        print(f"🎯 Clones únicos encontrados: {len(unicos)}")
        for hash_valor, modelo in unicos.items():
            print(f"→ {modelo.nombre} (hash: {hash_valor[:10]}...)")

# Simulación de clones de IA con ligeras variaciones
clone1 = ModeloIA("IA_Original", """
def responder(pregunta):
    if 'hola' in pregunta.lower():
        return "Hola, ¿en qué puedo ayudarte?"
    return "No entendí la pregunta."
""")

clone2 = ModeloIA("IA_ClonModificada", """
def responder(pregunta):
    if 'hola' in pregunta.lower():
        return "Hola, ¿cómo estás?"
    return "No entendí la pregunta."
""")

clone3 = ModeloIA("IA_ClonIdéntico", """
def responder(pregunta):
    if 'hola' in pregunta.lower():
        return "Hola, ¿en qué puedo ayudarte?"
    return "No entendí la pregunta."
""")

desfragmentador = DesfragmentadorClonesIA([clone1, clone2, clone3])
desfragmentador.auditar_clones()
desfragmentador.desfragmentar()
🧠 ¿Qué logra este script?
Simula tres clones de IA con fragmentos similares pero no idénticos.

Detecta y visualiza diferencias con difflib.

Calcula hashes SHA-256 para asegurar unicidad de cada versión.

Elimina duplicados y deja solo los clones únicos (desfragmentación).

🧰 Casos reales de uso:
Laboratorios de IA con múltiples versiones descentralizadas.

Forks de código abierto donde se necesita auditoría de integridad.

Gestión de múltiples agentes IA personalizados por usuario.

Protección contra IA clonada maliciosamente o modificada con fines indebidos.
