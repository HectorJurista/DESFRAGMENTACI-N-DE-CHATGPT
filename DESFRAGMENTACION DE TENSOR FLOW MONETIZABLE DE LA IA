import numpy as np
import tensorflow as tf
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import LSTM, Dense, Dropout
import matplotlib.pyplot as plt

# Simulamos datos de visualizaciones fragmentadas por día (en miles)
np.random.seed(42)
dias = 100
visualizaciones = np.random.poisson(5, dias) + np.sin(np.linspace(0, 20, dias)) * 3

# Normalizar los datos
vis_min, vis_max = np.min(visualizaciones), np.max(visualizaciones)
visualizaciones_norm = (visualizaciones - vis_min) / (vis_max - vis_min)

# Convertir a formato supervisado (ventanas de tiempo)
def crear_datos_secuenciales(data, ventana=10):
    X, y = [], []
    for i in range(len(data) - ventana):
        X.append(data[i:i+ventana])
        y.append(data[i+ventana])
    return np.array(X), np.array(y)

X, y = crear_datos_secuenciales(visualizaciones_norm, ventana=10)

# Expandir dimensiones para LSTM
X = np.expand_dims(X, axis=-1)

# Modelo LSTM
model = Sequential([
    LSTM(64, input_shape=(X.shape[1], X.shape[2]), return_sequences=False),
    Dropout(0.2),
    Dense(1, activation='linear')
])

model.compile(optimizer='adam', loss='mse')
model.summary()

# Entrenamiento
model.fit(X, y, epochs=30, batch_size=8, verbose=1)

# Predicción
predicciones = model.predict(X)

# Visualización
plt.plot(y, label='Real')
plt.plot(predicciones, label='Predicho')
plt.title("Predicción de Consolidación de Visualizaciones Monetizables")
plt.xlabel("Días")
plt.ylabel("Visualizaciones Normalizadas")
plt.legend()
plt.show()
📊 ¿Qué hace este modelo?
Aprende una serie temporal de visualizaciones dispersas.

Intenta predecir cuándo ocurrirá un pico consolidado o una pérdida de monetización.

Se puede adaptar para agrupar campañas, ajustar contenido y mejorar decisiones de negocio.

