import pandas as pd
from transformers import pipeline
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity
import numpy as np

class Tuit:
    def __init__(self, contenido, autor, fecha):
        self.contenido = contenido
        self.autor = autor
        self.fecha = fecha

    def __str__(self):
        return f"{self.autor} ({self.fecha}): {self.contenido}"

class DesfragmentadorTuits:
    def __init__(self, tuits):
        self.tuits = tuits
        self.model = pipeline("zero-shot-classification")
        self.topicos = ['política', 'deportes', 'tecnología', 'cultura', 'salud']

    def clasificar_tuits(self):
        print("🔍 Clasificando tuits por tema...\n")
        for tuit in self.tuits:
            tuit.topico = self.model(tuit.contenido, candidate_labels=self.topicos)['labels'][0]
            print(f"Tuit clasificado: {tuit.contenido} → {tuit.topico}")

    def eliminar_duplicados(self):
        print("\n🧹 Eliminando tuits duplicados...")
        tuits_unicos = []
        for tuit in self.tuits:
            if not any(tuit.contenido == t.contenido for t in tuits_unicos):
                tuits_unicos.append(tuit)
        print(f"Tuits después de eliminar duplicados: {len(tuits_unicos)}")
        self.tuits = tuits_unicos

    def agrupar_por_topico(self):
        print("\n📚 Agrupando tuits por tema...\n")
        tuits_agrupados = {topico: [] for topico in self.topicos}
        for tuit in self.tuits:
            tuits_agrupados[tuit.topico].append(tuit)
        return tuits_agrupados

    def mostrar_reporte(self, tuits_agrupados):
        for topico, tuits in tuits_agrupados.items():
            print(f"\n🌐 Tuits sobre {topico.upper()}:")
            for tuit in tuits:
                print(f"   - {tuit}")

# Simulación de tuits desordenados
tuits = [
    Tuit("Hoy se firmó un nuevo acuerdo de paz en Colombia", "usuario1", "2025-05-03"),
    Tuit("El fútbol colombiano sigue creciendo", "usuario2", "2025-05-03"),
    Tuit("La última actualización de iOS trae nuevas funciones", "usuario3", "2025-05-03"),
    Tuit("Un análisis sobre la política económica global", "usuario1", "2025-05-02"),
    Tuit("El fútbol colombiano está mejorando en el ámbito internacional", "usuario2", "2025-05-03"),
    Tuit("Nuevo descubrimiento en biomedicina puede salvar vidas", "usuario4", "2025-05-01"),
]

# Crear desfragmentador y analizar tuits
desfragmentador = DesfragmentadorTuits(tuits)
desfragmentador.clasificar_tuits()
desfragmentador.eliminar_duplicados()
tuits_agrupados = desfragmentador.agrupar_por_topico()
desfragmentador.mostrar_reporte(tuits_agrupados)
¿Qué hace este código?
Clasificación de tuits: Utiliza un modelo de clasificación de texto (zero-shot-classification de Hugging Face) para asignar etiquetas temáticas (como política, deportes, tecnología) a cada tuit.

Eliminación de duplicados: Revisa si algún tuit ya ha sido publicado anteriormente (basado en el contenido exacto) y lo elimina si es un duplicado.

Agrupación por tema: Agrupa los tuits en categorías temáticas (como política, deportes, etc.) y los organiza de manera más coherente.

Reporte: Muestra un resumen de los tuits agrupados por tema.

