from datetime import datetime
import re

class FragmentoHistorico:
    def __init__(self, descripcion, fecha):
        self.descripcion = descripcion
        self.fecha = datetime.strptime(fecha, "%Y-%m-%d")

    def __str__(self):
        return f"{self.fecha.strftime('%Y-%m-%d')} → {self.descripcion}"

class DesfragmentadorHistoria:
    def __init__(self):
        self.fragmentos = []

    def agregar_fragmento(self, descripcion, fecha):
        try:
            fragmento = FragmentoHistorico(descripcion, fecha)
            self.fragmentos.append(fragmento)
        except ValueError:
            print(f"❌ Fecha inválida para fragmento: {descripcion}")

    def desfragmentar(self):
        print("🔍 Desfragmentando eventos históricos...\n")
        self.fragmentos.sort(key=lambda x: x.fecha)
        for i, f in enumerate(self.fragmentos):
            print(f"{i+1}. {f}")
        
        # Detectar huecos temporales
        print("\n📉 Detección de saltos temporales significativos:")
        for i in range(1, len(self.fragmentos)):
            diferencia = (self.fragmentos[i].fecha - self.fragmentos[i-1].fecha).days
            if diferencia > 365:  # más de un año entre eventos
                print(f"⚠️ Salto de {diferencia} días entre:")
                print(f"   → {self.fragmentos[i-1]}")
                print(f"   → {self.fragmentos[i]}")

# Simulación de fragmentos históricos desordenados
eventos = [
    ("Caída del Muro de Berlín", "1989-11-09"),
    ("Inicio de la Segunda Guerra Mundial", "1939-09-01"),
    ("Llegada del hombre a la Luna", "1969-07-20"),
